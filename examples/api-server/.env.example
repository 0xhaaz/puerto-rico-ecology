# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=boriken_biodiversity
DB_USER=biodiv_api
DB_PASSWORD=your_secure_password_here
DB_POOL_MAX=20
DB_POOL_MIN=5

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Authentication
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
API_KEY_HEADER=X-API-Key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_AUTH_MAX=5000
RATE_LIMIT_CULTURAL_MAX=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Web3 Configuration
WEB3_PROVIDER_URL=https://mainnet.base.org
CONSERVATION_TOKEN_CONTRACT=0x...
NFT_CONTRACT_ADDRESS=0x...
DAO_CONTRACT_ADDRESS=0x...

# External Services
IPFS_GATEWAY=https://ipfs.io/ipfs/
IPFS_API_URL=https://api.pinata.cloud

# Cultural Protocol Settings
FPIC_REQUIRED=true
CULTURAL_GUARDIAN_EMAIL=guardians@boriken-biodiversity.org

# Pagination Defaults
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600
